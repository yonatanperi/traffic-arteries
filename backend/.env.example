# Backend configuration. Copy to backend/.env for local dev (git-ignored).
# Every value is read from the environment with a safe fallback in settings.py,
# so locally you can leave most of these unset.

# Django core
DEBUG=True
SECRET_KEY=dev-only-not-secret-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,traffic-arteries.onrender.com
CORS_ALLOWED_ORIGINS=https://traffic-arteries.pages.dev

# PostgreSQL (Neon). Leave unset locally to fall back to SQLite.
# DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cloudflare R2 (S3-compatible). Leave all of these unset locally to fall back
# to the on-disk JSON store under backend/data (no cloud credentials needed).
# In production set all four so the route/graph data lives in R2.
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=traffic-arteries
# Optional: override the full endpoint (derived from R2_ACCOUNT_ID when unset).
# R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# Optional: override the local-fallback data directory (default: backend/data).
# LOCAL_DATA_DIR=
